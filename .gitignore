# Microsoft Office temporary lock files (created when a file is open)
~$*.docx
~$*.xlsx
~$*.pptx
~$*.doc
~$*.xls
~$*.ppt

# Python cache & bytecode
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Virtual environments
venv/
.venv/
env/
.env/
ENV/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# Secrets / credentials (never commit these)
*.env
secrets.py
credentials.json

# Large data files (keep outputs/ PNGs but skip very large artifacts)
*.csv
*.pkl
*.joblib
